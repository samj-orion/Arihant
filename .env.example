# Arihant - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# SUPABASE CONFIGURATION (Required)
# Get these from: Supabase Dashboard > Project Settings > API
# =============================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# FRONTEND URL (Required for CORS & Supabase Auth redirects)
# =============================================================================
# Development
FRONTEND_URL=http://localhost:5173
# Production (update after deploy)
# FRONTEND_URL=https://arihant.yourdomain.com

# =============================================================================
# EMAILJS CONFIGURATION (Required for Contact/Bulk Inquiry forms)
# Get these from: EmailJS Dashboard > Account > API Keys
# =============================================================================
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# =============================================================================
# ANALYTICS (Optional)
# =============================================================================
# Vercel Analytics (add after deploying to Vercel)
# VITE_VERCEL_ANALYTICS_ID=your_analytics_id

# Google Analytics (if using GA4)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================================================
# PAYMENT GATEWAY (Optional - for future checkout integration)
# =============================================================================
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxx
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================
# Enable/disable features without code changes
# VITE_ENABLE_PWA=false
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_DEMAND_INTELLIGENCE=true

# =============================================================================
# DEVELOPMENT ONLY (Not used in production)
# =============================================================================
# VITE_DEBUG_MODE=true
# VITE_MOCK_API=false